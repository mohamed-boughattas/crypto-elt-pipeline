# Environment Variables for Crypto ELT Pipeline
# Copy this file to .env and fill in your values

# API Configuration
# Optional: API key for premium CoinGecko access (if needed)
COINGECKO_API_KEY=your_api_key_here

# Database Configuration
# Optional: Custom DuckDB path (defaults to data/crypto.duckdb)
DUCKDB_PATH=data/crypto.duckdb

# Monitoring Configuration
# Optional: Custom log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Performance Configuration
# Optional: Memory limit for DuckDB operations in GB
DUCKDB_MEMORY_LIMIT=8

# Development Configuration
# Optional: Enable debug mode for more verbose logging
DEBUG=false

# API Server Configuration
# CORS origins (comma-separated list of allowed origins, use * for all)
CORS_ORIGINS=*
# Rate limiting: maximum requests per client per period
API_RATE_LIMIT=10000
# Rate limiting: time period in seconds
API_RATE_PERIOD=60

# Note: This file is for reference only. Create a .env file with your actual values.
# The .env file is ignored by git for security reasons.